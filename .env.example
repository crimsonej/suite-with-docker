# ── NVIDIA AI Configuration ──
# Required for ./ai and ./ai image commands
NVIDIA_API_KEY=
# Optional overrides (default values shown below)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_IMAGE_INVOKE_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.2-klein-4b

# ── Railway Session Auto-Persistence ──
# Create in Railway -> Account Settings -> Tokens
RAILWAY_API_TOKEN=
# Automatically populated by the bot after first QR scan
SESSION_DATA=

# ── Core Engine Settings ──
DNS_SERVERS=8.8.8.8,8.8.4.4,1.1.1.1,1.0.0.1
PREFIX=./

# ── Media Downloader ──
# YouTube cookies in any format (JSON, header string, Base64, or Netscape)
YT_COOKIES=
YT_COOKIES_PATH=./cookies.txt
YT_PO_TOKEN=

# ── Geolocation & Intel ──
IPINFO_TOKEN=
